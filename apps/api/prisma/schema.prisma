generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HOSPITAL
  PROFESSIONAL
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
}

enum ShiftStatus {
  OPEN
  FILLED
  CANCELLED
  COMPLETED
}

enum ApplicationStatus {
  PENDING
  PENDING_CONFIRMATION
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ChargeStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum CouncilType {
  CRM
  COREN
}

enum CompensationType {
  MONEY
  HOUR_BANK
  OTHER
}

enum StaffStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum StaffType {
  FIXO
  AVULSO
}

enum SwapRequestStatus {
  OPEN
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum SwapInterestStatus {
  PENDING
  SELECTED
  REJECTED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED_PENDING_COVERAGE
  CANCELLATION_REQUESTED
  COVERED
  REJECTED
  CANCELLED
}

enum AbsenceType {
  ATESTADO
  LICENCA
  OUTRO
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  hospitalProfile       HospitalProfile?
  professionalProfile   ProfessionalProfile?
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  notifications         Notification[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum NotificationType {
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  APPLICATION_PENDING_CONFIRMATION
  APPLICATION_CONFIRMED
  NEW_APPLICATION
  SWAP_INTEREST
  SWAP_APPROVED
  SWAP_REJECTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_COVER_INTEREST
  LEAVE_COVERED
  LEAVE_CANCELLATION_REQUESTED
  LEAVE_CANCELLATION_DECIDED
  LEAVE_REQUEST_OPENED
  LEAVE_REQUEST_EXPIRED
  SHIFT_CANCELLED
  STAFF_INVITED
  STAFF_REMOVED
  ACCOUNT_STATUS_CHANGED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, read])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model HospitalProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                    String
  cnpj                    String   @unique
  phone                   String
  street                  String
  number                  String
  complement              String?
  neighborhood            String
  city                    String
  state                   String
  zipCode                 String
  defaultRejectionMessage String?
  leaveCoverageDeadlineDays Int    @default(3)
  longLeaveThresholdMinutes Int    @default(720)
  latitude                Float?
  longitude               Float?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  shifts   Shift[]
  staff    HospitalStaff[]
  absences Absence[]

  @@index([cnpj])
  @@index([city])
  @@index([state])
}

model ProfessionalProfile {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  cpf           String      @unique
  phone         String
  councilType   CouncilType
  councilNumber String
  councilState  String
  city          String?
  state         String?
  zipCode       String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  specialties         ProfessionalSpecialty[]
  applications        Application[]
  hospitalLinks       HospitalStaff[]
  swapRequests        ShiftSwapRequest[]
  swapInterests       ShiftSwapInterest[]
  leaveRequests       LeaveRequest[]
  leaveCoverInterests LeaveCoverInterest[]
  absences            Absence[]
  charges             Charge[]

  @@index([cpf])
  @@index([councilNumber])
}

model Specialty {
  id   String @id @default(cuid())
  name String @unique

  shifts        Shift[]
  professionals ProfessionalSpecialty[]
}

model ProfessionalSpecialty {
  professionalId String
  specialtyId    String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  specialty      Specialty           @relation(fields: [specialtyId], references: [id])

  @@id([professionalId, specialtyId])
}

model Shift {
  id                   String           @id @default(cuid())
  hospitalId           String
  hospital             HospitalProfile  @relation(fields: [hospitalId], references: [id])
  specialtyId          String
  specialty            Specialty        @relation(fields: [specialtyId], references: [id])
  requiredCouncilType  CouncilType      @default(CRM)
  title                String
  description          String
  date                 DateTime         @db.Date
  startTime            String
  endTime              String
  location             String
  slots                Int              @default(1)
  filledSlots          Int              @default(0)
  status               ShiftStatus      @default(OPEN)
  compensationType     CompensationType @default(MONEY)
  compensationNote     String?
  coverageForAbsenceId String?
  coverageForAbsence   Absence?         @relation(fields: [coverageForAbsenceId], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  applications  Application[]
  swapRequests  ShiftSwapRequest[]
  leaveRequests LeaveRequest[]

  @@index([hospitalId])
  @@index([specialtyId])
  @@index([date])
  @@index([status])
  @@index([status, date])
  @@index([coverageForAbsenceId])
}

model Application {
  id              String              @id @default(cuid())
  shiftId         String
  shift           Shift               @relation(fields: [shiftId], references: [id])
  professionalId  String
  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id])
  status          ApplicationStatus   @default(PENDING)
  message         String?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  charge Charge?

  @@unique([shiftId, professionalId])
  @@index([shiftId])
  @@index([professionalId])
  @@index([status])
}

model Charge {
  id                  String       @id @default(cuid())
  applicationId       String       @unique
  application         Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  professionalId      String
  professional        ProfessionalProfile @relation(fields: [professionalId], references: [id])
  amountCents         Int
  status              ChargeStatus @default(PENDING)
  provider            String       @default("mercadopago")
  providerPreferenceId String?
  providerPaymentId   String?
  paidAt              DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([professionalId])
  @@index([status])
}

model HospitalStaff {
  id               String              @id @default(cuid())
  hospitalId       String
  hospital         HospitalProfile     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  professionalId   String
  professional     ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  status           StaffStatus         @default(INVITED)
  type             StaffType           @default(FIXO)
  hourBankMinutes  Int                 @default(0)
  availableDaysOff Int                 @default(0)
  invitedAt        DateTime            @default(now())
  joinedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([hospitalId, professionalId])
  @@index([hospitalId])
  @@index([professionalId])
  @@index([status])
}

model ShiftSwapRequest {
  id                       String              @id @default(cuid())
  shiftId                  String
  shift                    Shift               @relation(fields: [shiftId], references: [id])
  requestingProfessionalId String
  requestingProfessional   ProfessionalProfile @relation(fields: [requestingProfessionalId], references: [id])
  status                   SwapRequestStatus   @default(OPEN)
  reason                   String?
  selectedInterestId       String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  interests ShiftSwapInterest[]

  @@index([shiftId])
  @@index([requestingProfessionalId])
  @@index([status])
}

model ShiftSwapInterest {
  id             String              @id @default(cuid())
  swapRequestId  String
  swapRequest    ShiftSwapRequest    @relation(fields: [swapRequestId], references: [id], onDelete: Cascade)
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])
  status         SwapInterestStatus  @default(PENDING)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([swapRequestId, professionalId])
  @@index([swapRequestId])
  @@index([professionalId])
}

model LeaveRequest {
  id                      String              @id @default(cuid())
  shiftId                 String              @unique
  shift                   Shift               @relation(fields: [shiftId], references: [id])
  professionalId          String
  professional            ProfessionalProfile @relation(fields: [professionalId], references: [id])
  date                    DateTime            @db.Date
  durationMinutes         Int                 @default(0)
  reason                  String?
  status                  LeaveRequestStatus  @default(PENDING)
  selectedCoverInterestId String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  coverInterests LeaveCoverInterest[]

  @@index([professionalId])
  @@index([status])
}

model LeaveCoverInterest {
  id             String              @id @default(cuid())
  leaveRequestId String
  leaveRequest   LeaveRequest        @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])
  status         SwapInterestStatus  @default(PENDING)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([leaveRequestId, professionalId])
  @@index([leaveRequestId])
  @@index([professionalId])
}

model Absence {
  id             String              @id @default(cuid())
  hospitalId     String
  hospital       HospitalProfile     @relation(fields: [hospitalId], references: [id])
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])
  type           AbsenceType
  startDate      DateTime            @db.Date
  endDate        DateTime            @db.Date
  note           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  coverageShifts Shift[]

  @@index([hospitalId])
  @@index([professionalId])
  @@index([startDate])
  @@index([endDate])
}
